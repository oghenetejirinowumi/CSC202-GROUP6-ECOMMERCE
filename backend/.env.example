PORT=50000
FRONTEND_ORIGIN=http://localhost:3000,https://your-app.vercel.app
APP_BASE_URL=http://localhost:3000

# Production (Render persistent disk): file:/var/data/gadget-store.db
DATABASE_URL=

# Resend free tier transactional email
# Create an API key at https://resend.com
RESEND_API_KEY=

# Use a verified sender/domain in Resend, e.g.
# EMAIL_FROM=Teckvora <no-reply@your-domain.com>
EMAIL_FROM=
